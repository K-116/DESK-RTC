
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <RTClib.h>
#include <BigFont01_I2C.h>


LiquidCrystal_I2C lcd (0x27, 16,2);
RTC_DS3231 rtc;
BigFont01_I2C big(&lcd);


bool alarm = false;
float hum;
float temp;
int dateButton = 2;
int alarmButton = 3;
int buzzer = 5;
String ampm;
bool showdate = false;
char daysOfTheWeek[7][4] = {"SUN","MON","TUE","WED","THU","FRI","SAT"};

void setup() {
  Serial.begin(9600);
  lcd.init();
  rtc.begin();
  lcd.backlight();
  Wire.begin();
  big.begin();

  pinMode(dateButton, INPUT_PULLUP);
  pinMode(alarmButton, INPUT_PULLUP);
  pinMode(buzzer, OUTPUT);

  if(!rtc.begin()){
    lcd.print("NO RTC FOUND!");
    while(true);
  }
  lcd.clear();
  //rtc.adjust(DateTime(F(__DATE__), F(__TIME__)));
  
}


void loop() {
  DateTime now = rtc.now();
  
  if (digitalRead(dateButton)==LOW){
    showdate = !showdate;
    lcd.clear();
    delay(250);
  }

  

  if(showdate){
    drawInfoScreen(now);

  }
  else{
    clockScreen(now);
  }

  delay(50);
  

  

}
//clock
void clockScreen(DateTime now){
 int displayHour;

  
  if (now.hour() == 0) {
    displayHour = 12;
    ampm = "AM";
  } else if (now.hour() < 12) {
    displayHour = now.hour();
    ampm = "AM";
  } else if (now.hour() == 12) {
    displayHour = 12;
    ampm = "PM";
  } else {
    displayHour = now.hour() - 12;
    ampm = "PM";
  }
  
  // CURRENT TIME
  big.writeint(0, 0, displayHour, 2, true);   
  big.writeint(0, 8, now.minute(), 2, true);  
  lcd.print(ampm);
  
  //ALARM 
  if (displayHour == 12 && now.minute() == 29 && ampm == "PM" && !alarm){
    alarm = true;
    Serial.println("alarm on");
    //alarm sounds here
  }

  if (digitalRead(alarmButton)==LOW && alarm == true){
    delay(50);
    
    if(digitalRead(alarmButton)==LOW){
      alarm = false;
      Serial.println("stop");
      delay(6000);
      //stap the alarmm
    }
      
  }
  
  
  delay(20); 
}

//date
void drawInfoScreen(DateTime now) {
  float tempC = rtc.getTemperature();
  float tempF = (tempC * 1.8) + 32.0;

 

  
  big.writeint(0,0, now.month(),2, true);
  big.writechar(0,8, char(47));
  big.writeint(0,9, now.day(),2,true);
  //lcd.print(daysOfTheWeek[now.dayOfTheWeek()]);
}



